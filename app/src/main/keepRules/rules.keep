# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# --- kotlinx.serialization -------------------------------------------------
# The Retrofit bridge in PocketNetwork.kt looks serializers up reflectively
# from a java.lang.reflect.Type, so the generated $$serializer classes and the
# Companion.serializer() accessors have to survive shrinking. Without these the
# release build fails at runtime with "Serializer for class ... not found",
# which is exactly the kind of bug that only shows up after you ship.
-keepattributes *Annotation*, InnerClasses, Signature, RuntimeVisibleAnnotations, AnnotationDefault

-keepclassmembers class com.pocket.watchrecorder.** {
    *** Companion;
}
-keepclasseswithmembers class com.pocket.watchrecorder.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.pocket.watchrecorder.**$$serializer { *; }

# --- WorkManager -----------------------------------------------------------
# Workers are instantiated by name from the WorkManager database.
-keep class * extends androidx.work.ListenableWorker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}
